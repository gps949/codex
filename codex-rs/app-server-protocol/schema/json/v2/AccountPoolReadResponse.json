{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "AccountPoolAccount": {
      "properties": {
        "availability": {
          "$ref": "#/definitions/AccountPoolAvailability"
        },
        "backendResetsAt": {
          "default": null,
          "description": "Backend evidence of a natural reset, independent of the scheduler retry deadline.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "email": {
          "type": [
            "string",
            "null"
          ]
        },
        "isActive": {
          "type": "boolean"
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "planType": {
          "anyOf": [
            {
              "$ref": "#/definitions/PlanType"
            },
            {
              "type": "null"
            }
          ]
        },
        "priority": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "profileId": {
          "type": "string"
        },
        "rateLimits": {
          "$ref": "#/definitions/AccountPoolRateLimits"
        },
        "windowWarmup": {
          "anyOf": [
            {
              "$ref": "#/definitions/AccountPoolWindowWarmup"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Latest identity-preserving 5h-window warmup observation for standby accounts."
        }
      },
      "required": [
        "availability",
        "isActive",
        "priority",
        "profileId",
        "rateLimits"
      ],
      "type": "object"
    },
    "AccountPoolAvailability": {
      "oneOf": [
        {
          "properties": {
            "type": {
              "enum": [
                "available"
              ],
              "title": "AvailableAccountPoolAvailabilityType",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "title": "AvailableAccountPoolAvailability",
          "type": "object"
        },
        {
          "properties": {
            "resets_at": {
              "format": "int64",
              "type": [
                "integer",
                "null"
              ]
            },
            "type": {
              "enum": [
                "exhausted"
              ],
              "title": "ExhaustedAccountPoolAvailabilityType",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "title": "ExhaustedAccountPoolAvailability",
          "type": "object"
        },
        {
          "properties": {
            "reason": {
              "type": "string"
            },
            "type": {
              "enum": [
                "authenticationUnavailable"
              ],
              "title": "AuthenticationUnavailableAccountPoolAvailabilityType",
              "type": "string"
            }
          },
          "required": [
            "reason",
            "type"
          ],
          "title": "AuthenticationUnavailableAccountPoolAvailability",
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "enum": [
                "disabled"
              ],
              "title": "DisabledAccountPoolAvailabilityType",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "title": "DisabledAccountPoolAvailability",
          "type": "object"
        }
      ]
    },
    "AccountPoolRateLimitWindow": {
      "properties": {
        "resetsAt": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "usedPercent": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "usedPercent"
      ],
      "type": "object"
    },
    "AccountPoolRateLimits": {
      "properties": {
        "observedAt": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "primary": {
          "anyOf": [
            {
              "$ref": "#/definitions/AccountPoolRateLimitWindow"
            },
            {
              "type": "null"
            }
          ]
        },
        "primaryObservedAt": {
          "default": null,
          "description": "Time of accepted primary evidence; null stays unknown rather than borrowing the watermark.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "secondary": {
          "anyOf": [
            {
              "$ref": "#/definitions/AccountPoolRateLimitWindow"
            },
            {
              "type": "null"
            }
          ]
        },
        "secondaryObservedAt": {
          "default": null,
          "description": "Time of accepted secondary evidence; omitted windows keep their previous time.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "AccountPoolWindowWarmup": {
      "properties": {
        "attemptedAt": {
          "format": "int64",
          "type": "integer"
        },
        "consecutiveFailures": {
          "default": null,
          "format": "uint32",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "outcome": {
          "$ref": "#/definitions/AccountPoolWindowWarmupOutcome"
        },
        "phase": {
          "anyOf": [
            {
              "$ref": "#/definitions/AccountPoolWindowWarmupPhase"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Additive attempt phase; legacy clients can continue reading `outcome`."
        },
        "retryAfter": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "attemptedAt",
        "outcome"
      ],
      "type": "object"
    },
    "AccountPoolWindowWarmupOutcome": {
      "enum": [
        "succeeded",
        "failed",
        "skippedNoAuth"
      ],
      "type": "string"
    },
    "AccountPoolWindowWarmupPhase": {
      "description": "Distinguishes an ongoing or completed-but-unconfirmed attempt from a request failure.",
      "enum": [
        "inProgress",
        "unconfirmed"
      ],
      "type": "string"
    },
    "PlanType": {
      "enum": [
        "free",
        "go",
        "plus",
        "pro",
        "prolite",
        "promax",
        "team",
        "self_serve_business_prolite",
        "self_serve_business_usage_based",
        "business",
        "ent26",
        "enterprise_cbp_automation",
        "enterprise_cbp_usage_based",
        "enterprise",
        "edu",
        "edu_plus",
        "edu_pro",
        "unknown"
      ],
      "type": "string"
    }
  },
  "properties": {
    "accounts": {
      "items": {
        "$ref": "#/definitions/AccountPoolAccount"
      },
      "type": "array"
    },
    "activeGeneration": {
      "format": "uint64",
      "minimum": 0.0,
      "type": [
        "integer",
        "null"
      ]
    },
    "activeProfileId": {
      "type": [
        "string",
        "null"
      ]
    },
    "enabled": {
      "type": "boolean"
    }
  },
  "required": [
    "accounts",
    "enabled"
  ],
  "title": "AccountPoolReadResponse",
  "type": "object"
}